# Backend
NODE_ENV=development
PORT=3001

# Database (Railway Postgres)
DATABASE_URL=postgresql://user:password@host:5432/goin

# AI parsing
ANTHROPIC_API_KEY=sk-ant-...
# Extraction model. Default is claude-sonnet-4-6; override to trial a candidate.
# EXTRACTOR_MODEL=claude-sonnet-4-6
# Model for structured-data pages only (JSON-LD / __NEXT_DATA__), where the job
# is transcription rather than parsing messy HTML. Unset => EXTRACTOR_MODEL.
# Measure with `npm run compare:models` before setting this.
# EXTRACTOR_MODEL_STRUCTURED=claude-haiku-4-5-20251001

# Email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@goin.app
# Optional: a separate sender for newsletter briefs, on the same verified
# domain. Unset -> briefs go out from RESEND_FROM_EMAIL.
# NEWSLETTER_FROM_EMAIL=newsletter@afisz.cc

# Public origin of the frontend. Magic-link login emails are built as
# <APP_URL>/auth?token=... , so this MUST be the deployed site in production
# (e.g. https://<owner>.github.io/<repo>) or the emailed links point at
# localhost and nobody can sign in.
APP_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3001
